NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_CRYPTO_SECRET=your_crypto_secret_here

# Client talks to same-origin /api/* (proxied). Leave empty to use the proxy;
# set only to bypass the proxy and call a backend directly from the browser.
NEXT_PUBLIC_API_BASE_URL=

# Server-only (never sent to the browser). Used by app/api/[...path] proxy.
# Official Nirmala backend (public, no auth required as of this integration).
NIRMALA_BACKEND_URL=your_nirmala_backend_url_here
NIRMALA_API_TOKEN=your_nirmala_api_token_here

# Server-only. OpenWeather map-tile key, used by app/api/owm proxy. Paste yours here.
OPENWEATHER_API_KEY=your_openweather_api_key_here
